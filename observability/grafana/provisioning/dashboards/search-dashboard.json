{
  "title": "Search Projection",
  "refresh": "10s",
  "panels": [
    {
      "title": "Search Queries / Sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(dam_search_requests_total[1m]))", "legendFormat": "Queries/sec" }
      ]
    },
    {
      "title": "Search Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(dam_search_errors_total[1m])) / sum(rate(dam_search_requests_total[1m]))", "legendFormat": "Error Rate" }
      ]
    },
    {
      "title": "Search Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(dam_search_latency_seconds_bucket[1m])) by (le))", "legendFormat": "P99" },
        { "expr": "histogram_quantile(0.95, sum(rate(dam_search_latency_seconds_bucket[1m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.50, sum(rate(dam_search_latency_seconds_bucket[1m])) by (le))", "legendFormat": "P50" }
      ]
    }
  ]
}
