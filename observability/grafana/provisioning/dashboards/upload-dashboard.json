{
  "title": "Upload Orchestrator",
  "refresh": "10s",
  "panels": [
    {
      "title": "Upload Requests / Sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(dam_upload_requests_total[1m])) by (tenant, provider)", "legendFormat": "{{tenant}} - {{provider}}" }
      ]
    },
    {
      "title": "Upload Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(dam_upload_failures_total[1m])) / sum(rate(dam_upload_requests_total[1m]))", "legendFormat": "Error Rate" }
      ]
    },
    {
      "title": "Upload Latency (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(dam_upload_duration_seconds_bucket[1m])) by (le))", "legendFormat": "P99" },
        { "expr": "histogram_quantile(0.95, sum(rate(dam_upload_duration_seconds_bucket[1m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.50, sum(rate(dam_upload_duration_seconds_bucket[1m])) by (le))", "legendFormat": "P50" }
      ]
    }
  ]
}
