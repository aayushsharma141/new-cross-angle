{
    "compilerOptions": {
        "allowJs": true,
        "lib": [
            "ESNext",
            "dom"
        ],
        "strict": true,
        "noImplicitAny": false,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "**/*.ts"
    ]
}