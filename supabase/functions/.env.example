# ─────────────────────────────────────────────────────────────────────────────
# Edge function secrets — Cross Angle Interior
#
# These are NOT read from a file in production. Set each one in Supabase
# (Dashboard → Edge Functions → Secrets) or with:
#     supabase secrets set NAME=value
# For local `supabase functions serve`, copy this file to .env and fill it in.
# Never commit the filled-in file.
#
# The admin page Settings → Integrations shows which of these are set.
# The authoritative list is apps/web/src/lib/admin/integrations.ts; a test
# (integration-secrets.test.ts) fails if this file and the code drift.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically — do not set them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
LEAD_ALERT_EMAIL=
# Used for links inside emails. Falls back to SITE_URL, then the live domain.
APP_BASE_URL=
SITE_URL=
# Set to "false" to switch off the daily stale-lead digest.
STALE_LEAD_DAILY_DIGEST=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Without this, notifications fall back to a chat id hardcoded in the code.
TELEGRAM_CHAT_ID=
WEBHOOK_SECRET=

# ── PostHog (reporting API) ──────────────────────────────────────────────────
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ── ImageKit (media) ─────────────────────────────────────────────────────────
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── AI ───────────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Lead webhooks / Google Sheets ────────────────────────────────────────────
LEAD_WEBHOOK_SECRET=
WEBHOOK_SIGNATURE_SECRET=
GOOGLE_SHEETS_WEBHOOK_URL=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# Without this, messages use a number hardcoded in the code.
WHATSAPP_NUMBER=

# ── Monitoring & access ──────────────────────────────────────────────────────
SENTRY_DSN=
# Comma-separated extra browser origins allowed to call edge functions.
ALLOWED_ORIGINS=

# ── Optional tuning (safe defaults exist) ────────────────────────────────────
# RATE_LIMIT_MAX=
# RATE_LIMIT_WINDOW_MS=
# MAX_BODY_BYTES=
