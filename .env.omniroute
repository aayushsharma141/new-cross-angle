# OmniRoute Configuration
# Use this for local development with OmniRoute running locally

# OmniRoute API endpoint (development)
OMNIROUTE_API_URL=http://localhost:20128/v1

# OmniRoute API key (optional - depends on your setup)
# If you set REQUIRE_API_KEY=true in OmniRoute, you'll need this
OMNIROUTE_API_KEY=

# Model routing preferences
# Specify which models to use for different tasks
OMNIROUTE_AESTHETIC_MODEL=google/gemini-2.5-flash
OMNIROUTE_CAPTION_MODEL=google/gemini-2.5-flash

# Fallback to direct provider (set to false to require OmniRoute)
USE_DIRECT_PROVIDERS=false

# Provider credentials (for fallback or OmniRoute to use)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
