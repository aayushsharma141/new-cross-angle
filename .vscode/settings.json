{
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        ".",
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "css.lint.unknownAtRules": "ignore",
    "files.associations": {
        "*.css": "tailwindcss",
        "supabase/migrations/**/*.sql": "postgres"
    },
    "tailwindCSS.includeLanguages": {
        "css": "css"
    },
    "deno.enable": true,
    "deno.enablePaths": [
        "supabase/functions"
    ],
    "deno.unstable": [],
    "deno.lint": true,
    "ralphLoop.defaultMode": "Planning",
    "go.toolsEnvVars": {
        "GOTOOLCHAIN": "auto"
    },
    "claude-code.environmentVariables": [],
    "markdown.validate.enabled": false
}