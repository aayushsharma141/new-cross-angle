{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "*": ["./*"],
      "@/*": [
        "./src/*"
      ],
      "@repo/types": [
        "../../packages/types/src/index.ts"
      ],
      "@repo/types/*": [
        "../../packages/types/src/*"
      ]
    },
    // Overriding strict mode for now to prevent regressions during migration
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "src"
  ]
}