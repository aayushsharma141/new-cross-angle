{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/optimize-images.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build && node scripts/generate-sitemap.js",
    "postbuild": "node scripts/copy-indexes.js && node scripts/checks/bundle-budget.js",
    "optimize-images": "node scripts/optimize-images.js",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "arch:fitness": "vitest run src/test/architecture.test.ts",
    "arch:engine": "npx vite-node scripts/checks/architecture-engine.ts",
    "arch:drift": "npx vite-node scripts/checks/architecture-engine.ts --drift",
    "arch:knip": "knip --config knip.json",
    "arch:ts-prune": "ts-prune",
    "arch:metrics": "npx ts-node scripts/checks/metrics.ts",
    "report:engineering": "npx ts-node scripts/checks/engineering-report.ts",
    "arch:no-console": "node scripts/checks/no-console-log.js",
    "arch:supabase-auth": "node scripts/checks/supabase-auth-invariant.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:lighthouse": "lhci autorun",
    "test:chaos": "vitest run src/test/chaos",
    "test:load:tier-a": "npx vite-node src/test/load/tier-a-harness.ts",
    "test:load:tier-b:server": "npx vite-node src/test/load/load-test-server.ts",
    "test:load:tier-b:baseline": "docker run --rm -i -e TEST_TYPE=baseline -v \"%cd%:/app\" -w /app grafana/k6 run src/test/load/scenarios.js",
    "test:load:tier-b:stress": "docker run --rm -i -e TEST_TYPE=stress -v \"%cd%:/app\" -w /app grafana/k6 run src/test/load/scenarios.js",
    "test:load:tier-b:soak": "docker run --rm -i -e TEST_TYPE=soak -v \"%cd%:/app\" -w /app grafana/k6 run src/test/load/scenarios.js",
    "test:load:tier-b:chaos": "docker run --rm -i -e TEST_TYPE=chaos -v \"%cd%:/app\" -w /app grafana/k6 run src/test/load/scenarios.js"
  },
