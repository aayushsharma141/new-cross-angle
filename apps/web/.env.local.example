# CrossAngle Interior — Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials
# Never commit .env.local to version control

# ----------------------------------------------------------------
# Supabase — required
# ----------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ⚠️  NEVER put the service_role key here — it must only live in
#     Supabase Edge Functions as a server-side secret.
# VITE_SUPABASE_SERVICE_ROLE_KEY=  ← DO NOT USE IN FRONTEND

# ----------------------------------------------------------------
# Sentry — error monitoring (EU Data Residency region)
# ----------------------------------------------------------------
# Client DSN — found in: sentry.io → Settings → Projects → crossangle-web → Client Keys
VITE_SENTRY_DSN=https://451f0e14eb8846a444926a7140a725fe@o4511375281487872.ingest.de.sentry.io/4511375283454032

# Controls which environment label appears in Sentry (development | staging | production)
VITE_SENTRY_ENV=development

# Git SHA injected at build time for source-map linking (set in CI, not manually)
# VITE_RELEASE=

# Required at BUILD TIME for Sentry Vite plugin to upload source maps.
# Found in: sentry.io → Settings → Auth Tokens → Create Token
#   Token type: Internal Integration or User Auth Token
#   Scopes required: project:write, project:read, org:read, releases:write
# Set in CI/CD secrets AND in Vercel environment variables — never commit to .env files.
# SENTRY_AUTH_TOKEN=<your-sentry-auth-token>
# SENTRY_ORG=<your-org-slug>  ← find in sentry.io URL: sentry.io/organizations/{slug}/
# SENTRY_PROJECT=<your-project-slug>  ← find in sentry.io project settings

# ----------------------------------------------------------------
# ImageKit — CDN image optimization
# ----------------------------------------------------------------
# Found in: imagekit.io → Dashboard → URL endpoint
VITE_IMAGEKIT_URL_ENDPOINT=

# ----------------------------------------------------------------
# PostHog — product analytics (optional)
# ----------------------------------------------------------------
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
