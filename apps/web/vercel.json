{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(?:jpg|jpeg|png|svg|webp|avif|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://xapjwemjbsrigeufxylj.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/((?!api|sitemap\\.xml|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
