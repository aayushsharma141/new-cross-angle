# ─────────────────────────────────────────────────────────────────────────────
# Cross Angle Interior — Environment Variables Reference
# Copy this file to apps/web/.env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────────────────
# Required. Find these in your Supabase project: Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional legacy alias (same value as VITE_SUPABASE_ANON_KEY)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── PostHog Analytics ────────────────────────────────────────────────────────
# Optional. Find in PostHog: Project Settings → Project API Key
# Leave blank to disable PostHog in development.
VITE_POSTHOG_KEY=phc_your_posthog_key

# ── Sentry Error Tracking ────────────────────────────────────────────────────
# Optional. Find in Sentry: Project → Settings → Client Keys (DSN)
# Leave blank to disable error reporting in development.
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id
# Optional. Defaults to Vite mode ('production' | 'development').
VITE_SENTRY_ENV=development
# Optional. Git SHA for release tracking. Typically set at build time:
#   VITE_RELEASE=$(git rev-parse --short HEAD)
VITE_RELEASE=

# ── ImageKit CDN ─────────────────────────────────────────────────────────────
# Optional. Your ImageKit URL endpoint. Falls back to Supabase Storage if not set.
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id/cross-angle
# Optional. Set to 'true' to skip ImageKit CDN transforms and use Supabase URLs directly.
VITE_BYPASS_IMAGEKIT=false

# ── Google Analytics ─────────────────────────────────────────────────────────
# Optional. For GA4 integration via CookieConsentProvider.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────────────
# Playwright E2E Tests (root .env.local only — not required for web app)
# ─────────────────────────────────────────────────────────────────────────────
# PLAYWRIGHT_BASE_URL=http://localhost:8080
# PLAYWRIGHT_ADMIN_EMAIL=your-admin@email.com
# PLAYWRIGHT_ADMIN_PASSWORD=  ← set via CI secret, never commit
